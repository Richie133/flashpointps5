++/// Roots set by the Ruffle Flash PS5 frontend for a Flashpoint launch
++/// (RUFFLE_WEB_ROOTS, separated by ';'): the first one holding
++/// <root>/<host>/<path> answers an http(s) request, as a file:// URL.
++#[cfg(ps5)]
++fn flashpoint_web_file(url: &str) -> Option<String> {
++    let roots = std::env::var("RUFFLE_WEB_ROOTS").ok()?;
++    let parsed = Url::parse(url).ok()?;
++    if parsed.scheme() != "http" && parsed.scheme() != "https" {
++        return None;
++    }
++    let host = parsed.host_str()?.to_ascii_lowercase();
++    // percent-decode the path ("my%20game/a.swf" is "my game/a.swf" on disk)
++    let raw = parsed.path().as_bytes();
++    let mut decoded = Vec::with_capacity(raw.len());
++    let mut i = 0;
++    while i < raw.len() {
++        if raw[i] == b'%' && i + 2 < raw.len() {
++            if let Some(b) = std::str::from_utf8(&raw[i + 1..i + 3])
++                .ok()
++                .and_then(|h| u8::from_str_radix(h, 16).ok())
++            {
++                decoded.push(b);
++                i += 3;
++                continue;
++            }
++        }
++        decoded.push(raw[i]);
++        i += 1;
++    }
++    let rel = String::from_utf8_lossy(&decoded).into_owned();
++    for root in roots.split(';').filter(|r| !r.is_empty()) {
++        let mut path = PathBuf::from(root);
++        path.push(&host);
++        for seg in rel.split('/') {
++            match seg {
++                "" | "." => continue,
++                ".." => return None,
++                _ => path.push(seg),
++            }
++        }
++        if path.is_dir() {
++            path.push("index.html");
++        }
++        if path.is_file() {
++            return Url::from_file_path(&path).ok().map(|u| u.to_string());
++        }
++    }
++    None
++}
++
+ // Url doesn't implement from_file_path and to_file_path for WASM targets.
+ // Therefore, we need to use cfg to make Ruffle compile for all targets.
+ 
