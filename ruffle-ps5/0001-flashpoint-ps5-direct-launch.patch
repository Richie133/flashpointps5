@@ -0,0 +1,104 @@
+//! Direct launches from Flashpoint PS5 (the Flashpoint Launcher/Database
+//! port for PS5 homebrew).
+//!
+//! Flashpoint PS5 writes /data/ruffle/launch.txt, then starts this app:
+//!
+//! ```text
+//! title=Some Game
+//! swf=/data/ruffle/flashpoint/<id>/www.example.com/game/game.swf
+//! url=http://www.example.com/game/game.swf?level=2
+//! query=level=2
+//! root=/data/ruffle/flashpoint/<id>
+//! root=/data/flashpoint/Legacy/htdocs
+//! exit=1
+//! ```
+//!
+//! That game starts at once instead of the library. It believes it was
+//! loaded from `url` (for sitelocks), gets `query` as FlashVars, and its
+//! requests for http(s)://host/path are answered from the `root` folders
+//! (laid out as <root>/<host>/<path>; see patches/ruffle-flashpoint.patch).
+//! With exit=1 the app closes when the game is left from the quick menu.
+
+use std::fs;
+use std::sync::Mutex;
+
+pub const LAUNCH_FILE: &str = "/data/ruffle/launch.txt";
+/// Its presence tells Flashpoint PS5 this build reads launch.txt.
+pub const SUPPORT_FILE: &str = "/data/ruffle/.flashpoint-launch";
+/// Read by ruffle_core's NullNavigatorBackend.
+const ROOTS_ENV: &str = "RUFFLE_WEB_ROOTS";
+
+pub struct Launch {
+    pub swf: String,
+    pub url: Option<String>,
+    pub query: Option<String>,
+    pub roots: Vec<String>,
+    pub title: String,
+    pub exit_after: bool,
+}
+
+/// The running Flashpoint launch's page address and FlashVars.
+static CURRENT: Mutex<Option<(Option<String>, Option<String>)>> = Mutex::new(None);
+
+pub fn advertise() {
+    let _ = fs::write(SUPPORT_FILE, concat!(env!("CARGO_PKG_VERSION"), "\n"));
+}
+
+/// The pending launch, if any. The file is removed so it only runs once.
+pub fn take() -> Option<Launch> {
+    let text = fs::read_to_string(LAUNCH_FILE).ok()?;
+    let _ = fs::remove_file(LAUNCH_FILE);
+    let mut launch = Launch {
+        swf: String::new(),
+        url: None,
+        query: None,
+        roots: Vec::new(),
+        title: String::new(),
+        exit_after: true,
+    };
+    for line in text.lines() {
+        if line.starts_with('#') {
+            continue;
+        }
+        let Some((key, value)) = line.split_once('=') else { continue };
+        let value = value.trim().to_string();
+        match key.trim() {
+            "swf" => launch.swf = value,
+            "url" if !value.is_empty() => launch.url = Some(value),
+            "query" if !value.is_empty() => launch.query = Some(value),
+            "root" if !value.is_empty() => launch.roots.push(value),
+            "title" => launch.title = value,
+            "exit" => launch.exit_after = value != "0",
+            _ => {}
+        }
+    }
+    if launch.swf.is_empty() || !std::path::Path::new(&launch.swf).is_file() {
+        println!("[Flashpoint] launch.txt names no readable SWF ({})", launch.swf);
+        return None;
+    }
+    println!("[Flashpoint] launching {} ({})", launch.title, launch.swf);
+    Some(launch)
+}
+
+/// Starts (or, with None, ends) a Flashpoint launch.
+pub fn begin(launch: Option<&Launch>) {
+    // Safety: only this thread reads or writes the environment, and the
+    // player that reads it is created afterwards.
+    unsafe {
+        match launch {
+            Some(l) if !l.roots.is_empty() => std::env::set_var(ROOTS_ENV, l.roots.join(";")),
+            _ => std::env::remove_var(ROOTS_ENV),
+        }
+    }
+    *CURRENT.lock().unwrap() = launch.map(|l| (l.url.clone(), l.query.clone()));
+}
+
+/// The address the game should believe it was loaded from.
+pub fn spoof_url() -> Option<String> {
+    CURRENT.lock().unwrap().as_ref().and_then(|c| c.0.clone())
+}
+
+/// FlashVars from the launch command's query string.
+pub fn query() -> Option<String> {
+    CURRENT.lock().unwrap().as_ref().and_then(|c| c.1.clone())
+}
